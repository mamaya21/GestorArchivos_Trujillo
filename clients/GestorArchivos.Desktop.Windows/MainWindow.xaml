<Window x:Class="GestorArchivos.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor Archivos" Width="1200" Height="760" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#172A43" Padding="14" CornerRadius="8">
            <DockPanel>
                <TextBlock Text="Gestor Archivos · Windows" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="UserLabel" Foreground="White" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Border x:Name="LoginPanel" Background="White" CornerRadius="10" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="390">
                <StackPanel>
                    <TextBlock Text="Iniciar sesión" FontSize="25" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Usuario"/>
                    <TextBox x:Name="UserNameBox" Margin="0,6,0,16" Height="32"/>
                    <TextBlock Text="Contraseña"/>
                    <PasswordBox x:Name="PasswordInput" Margin="0,6,0,18" Height="32"/>
                    <Button x:Name="LoginButton" Content="Ingresar" Height="38" Click="Login_Click"/>
                    <TextBlock x:Name="LoginError" Foreground="#B42318" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
            <Grid x:Name="ExplorerPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Inicio" Click="Home_Click" Padding="14,7" Margin="0,0,8,0"/>
                    <Button Content="Atrás" Click="Back_Click" Padding="14,7" Margin="0,0,8,0"/>
                    <Button Content="Actualizar" Click="Refresh_Click" Padding="14,7" Margin="0,0,8,0"/>
                    <Button Content="Nueva carpeta" Click="NewFolder_Click" Padding="14,7" Margin="0,0,8,0"/>
                    <Button Content="Subir archivos" Click="Upload_Click" Padding="14,7" Margin="0,0,8,0"/>
                    <Button Content="Renombrar" Click="Rename_Click" Padding="14,7" Margin="0,0,8,0"/>
                    <Button Content="Eliminar" Click="Delete_Click" Padding="14,7" Margin="0,0,8,0"/>
                    <Button Content="Cerrar sesión" Click="Logout_Click" Padding="14,7"/>
                </WrapPanel>
                <ListView x:Name="ItemsList" Grid.Row="1" MouseDoubleClick="ItemsList_DoubleClick"
                          SelectionMode="Extended">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="430"/>
                            <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Kind}" Width="150"/>
                            <GridViewColumn Header="Tamaño" DisplayMemberBinding="{Binding SizeText}" Width="130"/>
                            <GridViewColumn Header="Versión" DisplayMemberBinding="{Binding Version}" Width="90"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,10,0,0" Foreground="#42526B" TextWrapping="Wrap"/>
    </Grid>
</Window>
