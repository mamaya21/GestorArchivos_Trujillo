<Window x:Class="GestorArchivos.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor Archivos" Icon="Assets/GestorArchivos.ico" Width="1250" Height="790" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F7F8FC"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1F2941"/>
        <SolidColorBrush x:Key="Muted" Color="#697389"/>
        <SolidColorBrush x:Key="Accent" Color="#6957D8"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#E1E4ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Background" Value="#FAFBFF"/>
            <Setter Property="BorderBrush" Value="#DDE1EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Background" Value="#FAFBFF"/>
            <Setter Property="BorderBrush" Value="#DDE1EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="6,9"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F1F7"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EDEAFF"/>
                    <Setter Property="Foreground" Value="#4735B5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="25,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Gestor de Archivos" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="Tus documentos, organizados y disponibles desde Windows."
                           Foreground="{StaticResource Muted}" Margin="1,6,0,18"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EEEAFE" CornerRadius="18"
                    Padding="16,8" VerticalAlignment="Top" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="UserLabel" Foreground="#4735B5" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E1E4ED" BorderThickness="1">
            <Grid>
                <Border x:Name="LoginPanel" Background="White" CornerRadius="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Padding="28">
                    <StackPanel>
                        <Border Background="#EEEAFE" Width="60" Height="60" CornerRadius="16"
                                HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="☁" Foreground="{StaticResource Accent}" FontSize="30"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Bienvenido" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Ingresa con tu cuenta de Gestor Archivos"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                   Margin="0,8,0,26"/>
                        <TextBlock Text="Usuario" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox x:Name="UserNameBox" Height="42" Margin="0,0,0,18"
                                 KeyDown="Login_KeyDown"/>
                        <TextBlock Text="Contraseña" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <PasswordBox x:Name="PasswordInput" Height="42" Margin="0,0,0,22"
                                     KeyDown="Login_KeyDown"/>
                        <Button x:Name="LoginButton" Content="Ingresar" Height="46"
                                Background="{StaticResource Accent}" Foreground="White"
                                BorderThickness="0" Margin="0" Click="Login_Click"
                                IsDefault="True"/>
                        <TextBlock x:Name="LoginError" Foreground="#B42318"
                                   TextWrapping="Wrap" Margin="0,15,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Grid x:Name="ExplorerPanel" Visibility="Collapsed" Margin="19,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="←" ToolTip="Atrás" Click="Back_Click" Padding="12,9"/>
                            <Button Content="⌂" ToolTip="Inicio" Click="Home_Click" Padding="12,9"/>
                            <Button Content="↻" ToolTip="Actualizar" Click="Refresh_Click" Padding="12,9"/>
                        </StackPanel>
                        <TextBlock x:Name="BreadcrumbText" Grid.Column="1" Text="Inicio"
                                   Foreground="#314566" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="6,0,15,0"/>
                        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" MaxWidth="790">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="＋  Nuevo archivo" Click="NewFile_Click"
                                        Background="#1D4DEB" Foreground="White" BorderThickness="0"/>
                                <Button Content="＋  Nueva carpeta" Click="NewFolder_Click"/>
                                <Button Content="↑  Subir archivos" Click="Upload_Click"/>
                                <Border BorderBrush="#D8DEEB" BorderThickness="1" CornerRadius="7"
                                        Background="#FAFBFF" Width="220" Height="39" Margin="4,0,0,0">
                                    <Grid>
                                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" Padding="10,0"
                                                 TextChanged="SearchBox_TextChanged"
                                                 ToolTip="Buscar archivos y carpetas"
                                                 />
                                    </Grid>
                                </Border>
                                <Button Content="Salir" ToolTip="Cerrar sesión" Click="Logout_Click"
                                        Margin="10,0,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="#E1E4ED" BorderThickness="1" CornerRadius="8">
                        <ListView x:Name="ItemsList" BorderThickness="0" Background="Transparent"
                                  MouseDoubleClick="ItemsList_DoubleClick" SelectionMode="Extended"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Renombrar" Click="Rename_Click"/>
                                    <MenuItem Header="Mover a papelera" Click="Delete_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="NOMBRE" Width="490">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji"
                                                               FontSize="19" Margin="2,0,12,0" Width="28"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource Ink}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="TIPO" DisplayMemberBinding="{Binding Kind}" Width="160"/>
                                    <GridViewColumn Header="TAMAÑO" DisplayMemberBinding="{Binding SizeText}" Width="150"/>
                                    <GridViewColumn Header="VERSIÓN" DisplayMemberBinding="{Binding VersionText}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <DockPanel Grid.Row="2" Margin="2,13,0,0">
            <TextBlock Text="●" Foreground="#289B73" Margin="0,0,7,0"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
