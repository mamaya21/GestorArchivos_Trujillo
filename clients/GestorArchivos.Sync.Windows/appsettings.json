{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "GestorArchivos.Sync.Windows": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "HH:mm:ss.fff ",
        "UseUtcTimestamp": false,
        "SingleLine": true
      }
    }
  },
  "Sync": {
    "ApiBaseUrl": "http://localhost:5015",
    "LocalRootPath": "C:\\GestorArchivosSync",
    "PollIntervalSeconds": 5,
    "ChangeBatchSize": 200
  }
}